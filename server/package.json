{
  "name": "campussync-erp-server",
  "version": "1.0.0",
  "description": "CampusSyncERP Backend - Smart College ERP System",
  "main": "src/server.js",
  "scripts": {
    "start": "npx prisma db push --schema=src/prisma/schema.prisma && node src/server.js",
    "dev": "npx nodemon src/server.js",
    "postinstall": "npx prisma generate --schema=src/prisma/schema.prisma",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "node src/prisma/seed.js",
    "prisma:studio": "npx prisma studio"
  },
  "keywords": [
    "erp",
    "college",
    "campus",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0"
  }
}
